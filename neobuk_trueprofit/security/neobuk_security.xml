<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Every model here is company-scoped; without these rules a
             multi-company database would leak one shop's takings to another. -->
        <record id="neobuk_fee_rule_company_rule" model="ir.rule">
            <field name="name">Fee Rule: per company</field>
            <field name="model_id" ref="model_neobuk_fee_rule"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>
        <record id="neobuk_shipping_rule_company_rule" model="ir.rule">
            <field name="name">Courier Cost Rule: per company</field>
            <field name="model_id" ref="model_neobuk_shipping_rule"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>
        <record id="neobuk_expense_company_rule" model="ir.rule">
            <field name="name">Operating Expense: per company</field>
            <field name="model_id" ref="model_neobuk_expense"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>
        <record id="neobuk_shop_task_company_rule" model="ir.rule">
            <field name="name">Shop Task: per company</field>
            <field name="model_id" ref="model_neobuk_shop_task"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>
        <record id="neobuk_day_close_company_rule" model="ir.rule">
            <field name="name">Day Close: per company</field>
            <field name="model_id" ref="model_neobuk_day_close"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>
    </data>
</odoo>
