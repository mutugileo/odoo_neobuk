<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Starting points carried over from the OpenCart build. Rates change,
             so these are a head start rather than the truth - the day close is
             what tells a merchant whether they are still right. -->
        <record id="fee_rule_cash" model="neobuk.fee.rule">
            <field name="name">Cash</field>
            <field name="provider_code">cash</field>
            <field name="percent">0.0</field>
            <field name="fixed">0.0</field>
            <field name="sequence">1</field>
        </record>
        <record id="fee_rule_mpesa" model="neobuk.fee.rule">
            <field name="name">M-Pesa</field>
            <field name="provider_code">mpesa</field>
            <field name="percent">1.0</field>
            <field name="fixed">0.0</field>
            <field name="sequence">2</field>
        </record>
        <record id="fee_rule_card" model="neobuk.fee.rule">
            <field name="name">Card</field>
            <field name="provider_code">card</field>
            <field name="percent">2.9</field>
            <field name="fixed">0.30</field>
            <field name="sequence">3</field>
        </record>
        <record id="fee_rule_cod" model="neobuk.fee.rule">
            <field name="name">Cash on Delivery</field>
            <field name="provider_code">cod</field>
            <field name="percent">0.0</field>
            <field name="fixed">1.50</field>
            <field name="sequence">4</field>
        </record>
        <record id="fee_rule_bank" model="neobuk.fee.rule">
            <field name="name">Bank Transfer</field>
            <field name="provider_code">bank</field>
            <field name="percent">0.0</field>
            <field name="fixed">0.0</field>
            <field name="sequence">5</field>
        </record>
    </data>
</odoo>
