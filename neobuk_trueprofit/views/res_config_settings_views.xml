<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_neobuk" model="ir.ui.view">
        <field name="name">res.config.settings.form.neobuk</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- pricing_setting_container is a real block in
                 sale/wizard/res_config_settings_views.xml; the app is
                 'sale_management'. -->
            <xpath expr="//block[@id='pricing_setting_container']" position="after">
                <block title="Shop Day &amp; True Profit" name="neobuk_block">
                    <setting string="Variance Tolerance"
                             help="How far the day may be out before a written reason is required.">
                        <field name="neobuk_variance_tolerance"/>
                    </setting>
                    <setting string="Fees on Untaxed Amount"
                             help="Most providers charge on the total the customer paid, tax included. Turn this on only if yours does not.">
                        <field name="neobuk_fee_base_untaxed"/>
                    </setting>
                    <setting string="Credit Income Account"
                             help="Account used when credit given at the day close becomes a customer invoice.">
                        <field name="neobuk_credit_account_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
